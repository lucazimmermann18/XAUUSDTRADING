# ── TwelveData (Pflicht — Preisdaten & Kerzenchart) ──────────────────────────
TWELVE_DATA_API_KEY=your_twelvedata_key_here

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# ── KI-Anbieter (optional — mindestens einen setzen für AI-Kommentar) ────────
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here
DEEPSEEK_API_KEY=your_deepseek_key_here
GEMINI_API_KEY=your_gemini_key_here

# ── Telegram Signal Bot (optional — für automatische Trade-Alerts) ────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
SCHEDULER_CAPITAL=1000
